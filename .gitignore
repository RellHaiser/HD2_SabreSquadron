# Build output (build.py: build/msvc/LS3DF.dll, build/*.exe; intermediates go to %TEMP%)
build/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.exe
*.dll
# MinGW objects and precompiled headers (tier 1's tier1_decls.h.gch is ~56 MB)
*.o
*.a
*.gch
__pycache__/
*.pyc

# Never commit files of the game (original DLLs, .dta archives, unpacked data) or
# reverse-engineering exports of the original binary.
*.dta
*.DTA

mods/
_re/tools/__pycache__
_re/tier1_fixups.json