        }
        }
    }
}

void TestController()
{
    SetUpCombat();
    SetUpMotion();
    SetUpDeaths();
    SetUpController();
    // CONTROLLER_ONLY: one part's tests alone (23a, 23b ...), for its mutation list.
    const char *only = std::getenv("CONTROLLER_ONLY");
    const auto run = [&](const char *part) { return !only || std::strcmp(only, part) == 0; };
    if (run("23a"))
        TestControllerLife();
}

