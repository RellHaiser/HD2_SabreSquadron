typedef void(CT_ *T_CVoid)(void *);
template <class R, class... A> R OCtl(uint32_t at, A... a)
{
    using F = R(CT_ *)(void *, A...);
    return OriginalAt<F>(at)(static_cast<void *>(g_oc), a...);
}

void TestControllerLife()
{
    C_Human *h = g_h.human;
    std::printf("controller life\n");
    // The constructor: each type, the fields (the vectors empty).
    for (E_HumanController type : CONTROLLER_TYPES) {
        C_HumanController *pc = new C_HumanController(type);
        uint8_t *oc = static_cast<uint8_t *>(OC_AlignedNew(0xC0, 16));
        // (The fields the original leaves as the allocation had them keep this mark: not compared.)
        std::memset(oc, 0xCD, 0xC0);
        typedef void(CT_ *T_Ctor)(void *, int);
        OriginalAt<T_Ctor>(0x00582ff0)(oc, type);
        const std::string why = ControllerDiffers(pc, oc, true);
