I3D_frame *g_targetFrame;
void SetUpController()
{
    S_quat none;
    none.Identity();
    g_targetFrame = NewFrame(FRAME_DUMMY, "target", S_vector(1, 1, 1), none, Box(S_vector(0.05f, 0.05f, 0.05f)), "", nullptr);
    const std::pair<uint32_t, const void *> redirects[] = {
        {0x007e53c2, FAKE(OC_AlignedNew)},
        {0x007e559c, FAKE(OC_AlignedFree)},
        {0x0051d780, FAKE(OC_FindNearest)},
        {0x0051d5a0, FAKE(OC_CheckpointGet)},
        {0x005a2fe0, FAKE(OC_DropAllItems)},
        {0x005a3490, FAKE(OC_DropItem)},
        {0x005a39d0, FAKE(OC_PickUpItem)},
        {0x005a2d50, FAKE(OC_ServerMoveItem)},
        {0x005a2e90, FAKE(OC_ServerTransferItem)},
        {0x005a37c0, FAKE(OC_TakeFromSupplyBox)},
        {0x0069ebf0, FAKE(OC_SetAlarm)},
        {0x0073f900, FAKE(OC_RemoveObject)},
        {0x00492930, FAKE(OC_OnInventoryEvent)},
        {0x005a6360, FAKE(OC_SetUnconscious)},
        {0x005a45f0, FAKE(OC_ExecuteBodyCommand)},
        {0x005ac2b0, FAKE(OC_GetClimbState)},
        {0x005ac310, FAKE(OC_IsWorkState5)},
    };
    for (const auto &r : redirects)
        RedirectOriginal(r.first, r.second);
    // The messages' vtables (the port's: two destructor slots, Read, Write).
    for (void **vt : {g_vtMsgMoveItem, g_vtMsgTransferItem, g_vtMsgDropItem, g_vtMsgRemoteRequest, g_vtMsg23, g_vtMsgSay}) {
        vt[0] = vt[1] = nullptr;
        vt[2] = vt[3] = reinterpret_cast<void *>(MS_Delete);
        vt[4] = vt[5] = vt[6] = vt[7] = reinterpret_cast<void *>(CT_Unexpected);
    }
    // The worn items' definitions: a vtable.
    for (void *&slot : g_defVt)
        slot = reinterpret_cast<void *>(CT_Unexpected);
    g_defVt[VSlot(&C_ItemDef::GetBehaviour)] = reinterpret_cast<void *>(DF_GetBehaviour);
    g_defVt[0x10 / 4] = reinterpret_cast<void *>(DF_GetBehaviour);
    for (auto &def : g_wornDefs)
        *reinterpret_cast<void ***>(def) = g_defVt;
    // The controllers.
    g_pc = new S_TestController(HUMAN_CONTROLLER_PLAYER);
    g_pc2 = new C_HumanController(HUMAN_CONTROLLER_SQUAD);
    typedef void(CT_ *T_Ctor)(void *, int);
    g_oc = static_cast<uint8_t *>(OC_AlignedNew(0xC0, 16));
    g_oc2 = static_cast<uint8_t *>(OC_AlignedNew(0xC0, 16));
    OriginalAt<T_Ctor>(0x00582ff0)(g_oc, HUMAN_CONTROLLER_PLAYER);
    OriginalAt<T_Ctor>(0x00582ff0)(g_oc2, HUMAN_CONTROLLER_SQUAD);
    g_names[g_pc] = g_names[g_oc] = "ctl";
    g_names[g_pc2] = g_names[g_oc2] = "ctl2";
    g_extraPointers.push_back({g_pc, g_oc});
    g_extraPointers.push_back({g_pc2, g_oc2});
    g_extraPointers.push_back({g_portOther, g_origOther});
    g_names[g_axes] = "axes";
    g_names[g_buttons] = "buttons";
    g_names[g_checkpointNet] = "checkpoints";
    g_names[g_fpvBytes] = "firstPersonView";
    for (int i = 0; i < 8; ++i)
        g_names[g_checkpointBytes[i]] = "checkpoint" + std::to_string(i);
    g_names[g_netObjectBytes] = "netObject";
}

