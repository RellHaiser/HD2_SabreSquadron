// A port pointer in the original's world.
void *ToOrig(const void *p)
{
    if (p == g_h.human)
        return o_human;
    if (p == g_portOther)
        return g_origOther;
    if (p == g_pc)
        return g_oc;
    if (p == g_pc2)
        return g_oc2;
    for (const auto &pq : g_extraPointers)
        if (pq.first == p)
            return pq.second;
    return const_cast<void *>(p);
}
// The port's controller copied into the original's layout (the message vectors emptied on both sides).
void ControllerToOrig(const C_HumanController *pc, uint8_t *oc)
{
    const auto *pb = reinterpret_cast<const uint8_t *>(pc);
    for (const S_LayoutField &f : kControllerFields) {
        if (f.kind == 'p') {
            void *p;
            std::memcpy(&p, pb + f.port, 4);
            p = ToOrig(p);
            std::memcpy(oc + f.orig, &p, 4);
        } else {
            std::memcpy(oc + f.orig, pb + f.port, f.size);
        }
    }
}
void EmptyMessages(C_HumanController *pc, uint8_t *oc)
{
    pc->m_toServer.clear();
    pc->m_toClients.clear();
    // (The original's vectors: allocator, first, last, end; their old arrays left behind.)
    std::memset(oc + 0x80, 0, 0x20);
}
// Which message class a vtable is (each side's), and its fields in each side's layout (the port's by offsetof).
struct S_MsgField {
    size_t port, orig, size;
};
struct S_MsgClass {
    const char *name;
    void **port;
    uint32_t orig;
    bool type;                                          // its type word compared (see below)
    std::vector<S_MsgField> fields;
};
const std::vector<S_MsgClass> &MessageClasses()
{
    static const std::vector<S_MsgClass> classes = {
        {"MoveItem", g_vtMsgMoveItem, 0x00810ca4, true,
         {{offsetof(S_MsgMoveItem, uid), 0x08, 4}, {offsetof(S_MsgMoveItem, other), 0x0C, 4},
          {offsetof(S_MsgMoveItem, fromContainer), 0x10, 4}, {offsetof(S_MsgMoveItem, toContainer), 0x14, 4},
          {offsetof(S_MsgMoveItem, slot), 0x18, 4}}},
        // (The original stores CTRL_MSG_MOVE_ITEM as a transfer's type, the port CTRL_MSG_TRANSFER_ITEM; its Write
        // sends CTRL_MSG_TRANSFER_ITEM either way: the type word is not compared.)
        {"TransferItem", g_vtMsgTransferItem, 0x00810cac, false,
         {{offsetof(S_MsgTransferItem, uid), 0x08, 4}, {offsetof(S_MsgTransferItem, arg), 0x0C, 4},
          {offsetof(S_MsgTransferItem, other), 0x10, 4}, {offsetof(S_MsgTransferItem, otherUid), 0x14, 4},
          {offsetof(S_MsgTransferItem, container), 0x18, 4}}},
        // (The direction's w: the original copies a word past the vector there.)
        {"DropItem", g_vtMsgDropItem, 0x00810cb4, true,
         {{offsetof(S_MsgDropItem, uid), 0x08, 4}, {offsetof(S_MsgDropItem, dir), 0x10, 12},
          {offsetof(S_MsgDropItem, speed), 0x20, 4}, {offsetof(S_MsgDropItem, actor), 0x24, 4}}},
        {"RemoteRequest", g_vtMsgRemoteRequest, 0x00810d0c, true, {{offsetof(S_MsgRemoteRequest, request), 0x08, 4}}},
        {"Msg23", g_vtMsg23, 0x00810cd4, true, {{offsetof(S_Msg23, on), 0x08, 1}}},
        {"Say", g_vtMsgSay, 0x00810cec, true, {{offsetof(S_MsgSay, sentence), 0x08, 4}, {offsetof(S_MsgSay, force), 0x0C, 1}}},
    };
    return classes;
}
std::string MessageText(const void *m, bool original)
{
    const auto *b = static_cast<const uint8_t *>(m);
    const void *vt = *static_cast<void *const *>(m);
    for (const S_MsgClass &c : MessageClasses()) {
        if (original ? vt != OriginalAt<void *>(c.orig) : vt != c.port + 2)
            continue;
        std::string s = std::string(c.name) + "[";
        if (c.type)
            s += std::to_string(*reinterpret_cast<const int *>(b + 4));
        for (const S_MsgField &f : c.fields) {
            for (size_t k = 0; k < f.size; k += 4) {
                uint32_t w = 0;
                std::memcpy(&w, b + (original ? f.orig : f.port) + k, std::min<size_t>(4, f.size - k));
                char t[16];
                std::snprintf(t, sizeof t, " %x", w);
                s += t;
            }
        }
        return s + "]";
    }
    return "?";
}
std::string PortMessages(const std::vector<S_ControllerMessage *> &v)
{
    std::string s;
    for (const S_ControllerMessage *m : v)
        s += MessageText(m, false);
    return s;
}
std::string OrigMessages(const uint8_t *vec)
{
    std::string s;
    void *const *first = *reinterpret_cast<void *const *const *>(vec + 4);
    void *const *last = *reinterpret_cast<void *const *const *>(vec + 8);
    for (void *const *p = first; p && p != last; ++p)
        s += MessageText(*p, true);
    return s;
}
// The two controllers after a call: their fields (pointers through ToOrig), their queued messages.
std::string ControllerDiffers(const C_HumanController *pc, const uint8_t *oc, bool onlyWritten = false)
{
    const auto *pb = reinterpret_cast<const uint8_t *>(pc);
    for (const S_LayoutField &f : kControllerFields) {
        for (size_t i = 0; i < f.size; i += 4) {
            uint32_t x = 0, y = 0;
            const size_t n = std::min<size_t>(4, f.size - i);
            std::memcpy(&x, pb + f.port + i, n);
            std::memcpy(&y, oc + f.orig + i, n);
            if (f.kind == 'p')
                x = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(ToOrig(reinterpret_cast<void *>(x))));
            if (onlyWritten && (y == 0xCDCDCDCDu || (n == 1 && y == 0xCDu)))
                continue;
            // (ApplyMoveControls: the original leaves a stack value in the look-at's w.)
            if (std::strcmp(f.name, "m_lookAt") == 0 && i == 12)
                continue;
            if (!WordsNear(x, y, f.kind)) {
                char text[160];
                std::snprintf(text, sizeof text, "controller.%s+%u (port %08x original %08x)", f.name, unsigned(i), x, y);
                return text;
            }
        }
    }
    const std::string ps = PortMessages(pc->m_toServer), os = OrigMessages(oc + 0x80);
    if (ps != os)
        return "to the server: port " + ps + ", original " + os;
    const std::string pcl = PortMessages(pc->m_toClients), ocl = OrigMessages(oc + 0x90);
    if (pcl != ocl)
        return "to the clients: port " + pcl + ", original " + ocl;
    return "";
}
// DiffCall on the controllers: the port's copied into the original's first, both compared after.
template <class P, class O> void ControllerCall(const char *what, P port, O original)
{
    ControllerToOrig(g_pc, g_oc);
    ControllerToOrig(g_pc2, g_oc2);
    DiffCall(what, port, original);
    const std::string why = ControllerDiffers(g_pc, g_oc);
    CHECK(why.empty());
    static int shown;
    if (!why.empty() && shown++ < 15)
        std::printf("  %s: %s\n", what, why.c_str());
}

const E_HumanController CONTROLLER_TYPES[] = {HUMAN_CONTROLLER_PLAYER, HUMAN_CONTROLLER_SQUAD, HUMAN_CONTROLLER_ENEMY,
