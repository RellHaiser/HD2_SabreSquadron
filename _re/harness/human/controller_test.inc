void RandomController()
{
    RandomOther();
    C_Human *h = g_h.human;
    RandomControllerFields(g_pc);
    g_pc->m_human = h;
    RandomControllerFields(g_pc2);
    EmptyMessages(g_pc, g_oc);
    EmptyMessages(g_pc2, g_oc2);
    h->m_controller = g_pc;
    g_localPlayerSlot = P(0.5f) ? h->m_netId : h->m_netId + 1;
    g_script.activeIsOwner = P(0.5f);
    // The game's walking network and first-person view (the original's game at +0x54, +0x5C).
    void *net = P(0.8f) ? g_checkpointNet : nullptr;
    GetGame()->m_checkpoints = static_cast<C_Checkpoints *>(net);
    std::memcpy(g_origGame + 0x54, &net, 4);
    void *fpv = g_fpvBytes;
    GetGame()->m_firstPersonView = static_cast<C_FirstPersonView *>(fpv);
    std::memcpy(g_origGame + 0x5C, &fpv, 4);
    g_cs.nearest = I(-1, 9);
    g_cs.moved = P(0.7f);
    g_cs.moveTo = I(0, 5);
    g_behaviour = P(0.3f) ? ITEM_BEHAVIOUR_THROWN : I(0, 12);
    for (auto &item : g_wornItems) {
        reinterpret_cast<C_Item *>(item)->SetUid(I(0, 500));
        reinterpret_cast<C_Item *>(item)->SetTime(uint32_t(I(0, 6000)));
    }
    for (float &a : g_axes)
        a = P(0.7f) ? 0.0f : U(-1, 1);
    for (float &b : g_buttons)
        b = P(0.8f) ? 0.0f : 1.0f;
    // The vehicle: none, a seat in one (a car, a submarine, a static weapon), another kind.
    h->m_vehicle = P(0.6f) ? nullptr : reinterpret_cast<C_Actor *>(g_vehicleBytes);
    static const int kinds[] = {ACTOR_CAR, ACTOR_SUBMARINE, ACTOR_STATIC_WEAPON, ACTOR_DOOR};
    const int kind = kinds[I(0, 3)];
    reinterpret_cast<C_Actor *>(g_vehicleBytes)->m_type = static_cast<E_ActorType>(kind);
    std::memcpy(g_vehicleBytes + 0x18, &kind, 4);
}

typedef void(CT_ *T_CVoid)(void *);
template <class R, class... A> R OCtl(uint32_t at, A... a)
{
    using F = R(CT_ *)(void *, A...);
    return OriginalAt<F>(at)(static_cast<void *>(g_oc), a...);
}

void TestControllerLife()
{
    C_Human *h = g_h.human;
    std::printf("controller life\n");
    // The constructor: each type, the fields (the vectors empty).
    for (E_HumanController type : CONTROLLER_TYPES) {
        C_HumanController *pc = new C_HumanController(type);
        uint8_t *oc = static_cast<uint8_t *>(OC_AlignedNew(0xC0, 16));
        // (The fields the original leaves as the allocation had them keep this mark: not compared.)
        std::memset(oc, 0xCD, 0xC0);
        typedef void(CT_ *T_Ctor)(void *, int);
        OriginalAt<T_Ctor>(0x00582ff0)(oc, type);
        const std::string why = ControllerDiffers(pc, oc, true);
