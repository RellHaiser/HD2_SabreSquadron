                                   g_targetFrame->GetWorldPos().y - g_h.frame->GetWorldPos().y,
                                   g_targetFrame->GetWorldPos().z - g_h.frame->GetWorldPos().z, 0.0f};
            ControllerCall("IsFacing", [&] { return int(g_pc->IsFacing(reinterpret_cast<C_Actor *>(g_portOther))); },
                           [&](void *) { return int(OCtl<uint32_t>(0x00584890, static_cast<void *>(g_origOther)) & 0xFF); });
            break;
        }
        case 35: {
            const float strength = U(0, 30);
            ControllerCall("RequestAction", [&] { g_pc->RequestAction(a, &v, &v, strength, b, c); return 0; },
                           [&](void *) { OCtl<void>(0x005830a0, a, &v, &v, strength, b, c); return 0; });
            break;
        }
        case 32:
            ControllerCall("SendMessage23", [&] { g_pc->SendMessage23(a & 1); return 0; },
                           [&](void *) { OCtl<void>(0x005890d0, a & 1); return 0; });
            break;
        default: {
            // Some messages queued (each side its own), then cleared.
            // (A client's remote requests go to the server, a server's to the clients.)
            const int n = I(0, 3);
            const bool toServer = P(0.5f);
            g_gameRole = toServer ? GAME_ROLE_CLIENT : GAME_ROLE_SERVER;
            ToOriginal();
            for (int k = 0; k < n; ++k) {
                g_pc->SendRemoteRequest(k + 1);
                OCtl<void>(0x00588d20, k + 1);
            }
            g_calls.clear();
            ControllerToOrig(g_pc, g_oc);
            // (ControllerCall would empty nothing: the vectors are kept.)
            DiffCall(toServer ? "ClearMessagesToServer" : "ClearMessagesToClients",
                     [&] {
                         if (toServer)
                             g_pc->ClearMessagesToServer();
                         else
                             g_pc->ClearMessagesToClients();
                         return 0;
                     },
                     [&](void *) { OCtl<void>(toServer ? 0x00588c60 : 0x00588cc0); return 0; });
            const std::string why = ControllerDiffers(g_pc, g_oc);
            CHECK(why.empty());
            if (!why.empty())
                std::printf("  clear: %s\n", why.c_str());
            break;
        }
        }
    }
}

