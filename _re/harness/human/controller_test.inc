namespace {
struct S_ControllerScript {
    int nearest = 3;                                    // C_CheckpointNetwork::FindNearest
    bool checkpoints = true;                            // the game has a walking network
    bool moved = true;                                  // ServerMoveItem / ServerTransferItem / PickUpItem
    int moveTo = 2;                                     // ServerMoveItem's container out
    int climbState = 0;                                 // S_HumanBody::GetClimbState
    bool workState5 = false;                            // S_HumanBody::IsWorkState5
    int moveSpeedClass = 0;                             // C_Human::GetMoveSpeedClass
    int stance = 0;                                     // C_Human::GetStance
    bool inPlay = true;                                 // C_Human::IsInPlay
    bool spectating = false;                            // C_Human::IsSpectating
    bool answer = true;                                 // the bool answers of the actors (doors, places ...)
    int sampleSize = 500;                               // GetDubbingSampleSize
    int speech = 300;                                   // the speech set's Say / SayNow
    C_Item *beltItem = nullptr;                         // FindBeltItem
    C_Item *found = nullptr;                            // FindItem / FindItemByUid / FindContainerOfBehaviour / FindWireCutter
    I3D_frame *itemFrame = nullptr;                     // C_Item::GetFrame
    I3D_frame *shotDummy = nullptr;                     // C_WeaponItem::GetShotDummy
    S_vector4 aimOrigin = {0, 1.5f, 0, 1}, aimDir = {0, 0, 1, 0};   // the first-person view's
    bool rayHit = true;                                 // C_Car::RayTest
} g_cs;
